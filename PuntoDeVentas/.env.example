# Copia este archivo como ".env" (sin .example) y completa los valores reales.
# El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).

# Genera una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True solo en desarrollo local. En producción SIEMPRE False.
DEBUG=True

# Hosts/dominios permitidos, separados por coma. Ej: midominio.com,www.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=punto_de_venta_db
DB_USER=administrador
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
